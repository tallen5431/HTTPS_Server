#!/usr/bin/env node

// Caddyfile generator for HTTPS_Server
// ------------------------------------
//
// Can be run manually:
//   node caddy_from_config.js > Caddyfile.generated
//   CADDYFILE_PATH=/etc/caddy/Caddyfile node caddy_from_config.js
//
// Or used programmatically from server.js:
//   const { generateCaddyFromConfig, getCaddyOptionsFromEnv, watchConfigForCaddy } = require('./caddy_from_config');
//
// Env vars:
//   CONFIG_FILE      - path to config.json (default ./config.json)
//   PUBLIC_BASE      - fallback PUBLIC_BASE if not present in programs
//   CADDYFILE_PATH   - where to write the generated Caddyfile (default ./Caddyfile.generated)
//   CADDY_FILE_OUT   - legacy alias for CADDYFILE_PATH
//   CADDY_TLS_CERT   - TLS cert path (default /etc/ssl/caddy/nuc-selfsign.crt)
//   CADDY_TLS_KEY    - TLS key path (default /etc/ssl/caddy/nuc-selfsign.key)
//   MANAGER_PORT     - internal port for HTTPS Server Manager (default 8061)
//   CADDY_MANAGER_PATH - URL path for Manager UI (default /manager)
//   CADDY_RELOAD_CMD - optional shell command to reload Caddy after write

const fs = require('fs');
const path = require('path');
const { exec } = require('child_process');

// -------------------------------
// Config + options
// -------------------------------

const CONFIG_FILE = process.env.CONFIG_FILE || path.join(__dirname, 'config.json');

function loadConfig() {
  try {
    const raw = fs.readFileSync(CONFIG_FILE, 'utf8');
    return JSON.parse(raw);
  } catch (err) {
    console.error('[caddy_from_config] Failed to read config file:', CONFIG_FILE);
    console.error(err.message || err);
    return { programs: [] };
  }
}

function getCaddyOptionsFromEnv() {
  const defaultPublicBase = process.env.PUBLIC_BASE || 'https://192.168.1.245:8443';

  let domain = 'localhost';
  let httpsPort = '443';

  try {
    const u = new URL(defaultPublicBase);
    if (u.hostname) domain = u.hostname;
    if (u.port) {
      httpsPort = u.port;
    } else if (u.protocol === 'https:') {
      httpsPort = '443';
    }
  } catch (err) {
    console.warn('[caddy_from_config] Could not parse PUBLIC_BASE, using defaults:', err && err.message ? err.message : err);
    domain = '192.168.1.245';
    httpsPort = '8443';
  }

  // Support both new and legacy env var names for output path
  const outputPath = process.env.CADDYFILE_PATH || process.env.CADDY_FILE_OUT || path.resolve(__dirname, 'Caddyfile.generated');

  const tlsCert = process.env.CADDY_TLS_CERT || '/etc/ssl/caddy/nuc-selfsign.crt';
  const tlsKey = process.env.CADDY_TLS_KEY || '/etc/ssl/caddy/nuc-selfsign.key';

  const managerPath = process.env.CADDY_MANAGER_PATH || '/manager';
  const managerPort = process.env.MANAGER_PORT || '8061';

  const reloadCommand = process.env.CADDY_RELOAD_CMD || '';

  return { outputPath, domain, httpsPort, tlsCert, tlsKey, managerPath, managerPort, reloadCommand };
}

// -------------------------------
// Helpers
// -------------------------------

function derivePathPrefix(urlValue) {
  if (!urlValue) return null;
  let u = String(urlValue).trim();

  // If a full URL is given, extract pathname
  if (u.startsWith('http://') || u.startsWith('https://')) {
    try {
      const parsed = new URL(u);
      u = parsed.pathname || '/';
    } catch {
      // leave as-is
    }
  }

  if (!u.startsWith('/')) u = '/' + u;
  if (u === '/') return null;

  // Drop trailing slashes
  return u.replace(/\/+$/, '');
}

// -------------------------------
// Build Caddyfile text
// -------------------------------

function buildCaddyFromConfig(config, options) {
  const cfg = config || {};
  const opts = options || getCaddyOptionsFromEnv();

  const lines = [];

  lines.push('# This file is AUTO-GENERATED by HTTPS_Server/caddy_from_config.js');
  lines.push('# Do not edit this file directly; edit config.json instead.');
  lines.push('');
  lines.push('{');
  lines.push('    auto_https off');
  lines.push(`    https_port ${opts.httpsPort}`);
  lines.push('}');
  lines.push('');
  lines.push(`https://${opts.domain} {`);
  lines.push(`    tls ${opts.tlsCert} ${opts.tlsKey}`);
  lines.push('');

  if (opts.managerPath && opts.managerPort) {
    lines.push('    # HTTPS Server Manager UI');
    lines.push(`    handle_path ${opts.managerPath}* {`);
    lines.push(`        reverse_proxy 127.0.0.1:${opts.managerPort}`);
    lines.push('    }');
    lines.push('');
  }

  if (Array.isArray(cfg.programs)) {
    lines.push('    # Application programs from config.json');

    for (const prog of cfg.programs) {
      if (!prog || !prog.id) continue;
      const env = prog.env || {};
      const port = env.PORT || env.port;
      const urlValue = prog.url;

      if (!port || !urlValue) {
        // Without PORT or URL we cannot generate a proxy block
        continue;
      }

      const prefix = derivePathPrefix(urlValue);
      if (!prefix) continue;

      const displayName = prog.name || prog.id;
      lines.push(`    # ${displayName}`);
      lines.push(`    handle_path ${prefix}* {`);
      lines.push(`        reverse_proxy 127.0.0.1:${port}`);
      lines.push('    }');
      lines.push('');
    }
  }

  lines.push('}');
  lines.push('');

  return lines.join('\n');
}

// -------------------------------
// Write + optional reload
// -------------------------------

function writeCaddyfile(caddyText, options) {
  const opts = options || getCaddyOptionsFromEnv();
  const outPath = opts.outputPath;
  const dir = path.dirname(outPath);

  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true });
  }

  fs.writeFileSync(outPath, caddyText, 'utf8');
  console.log(`[caddy_from_config] Wrote Caddyfile to ${outPath}`);
}

function maybeReloadCaddy(options) {
  const opts = options || getCaddyOptionsFromEnv();

  if (!opts.reloadCommand) {
    return;
  }

  exec(opts.reloadCommand, (err, stdout, stderr) => {
    if (err) {
      console.error('[caddy_from_config] Failed to reload Caddy:', err && err.message ? err.message : err);
      if (stderr) console.error(stderr.trim());
      return;
    }

    if (stdout) console.log(stdout.trim());
    console.log('[caddy_from_config] Reload command completed successfully.');
  });
}

// -------------------------------
// Public API used by server.js
// -------------------------------

function generateCaddyFromConfig(config, options) {
  const opts = options || getCaddyOptionsFromEnv();
  const text = buildCaddyFromConfig(config, opts);
  writeCaddyfile(text, opts);
  if (opts.reloadCommand) {
    maybeReloadCaddy(opts);
  }
  return opts.outputPath;
}

function watchConfigForCaddy(configPath, options, loadConfigFn, generateFn) {
  const cfgPath = configPath || CONFIG_FILE;

  if (!cfgPath || typeof fs.watch !== 'function') {
    return;
  }

  try {
    fs.watch(cfgPath, { persistent: false }, (eventType) => {
      if (eventType !== 'change') return;

      try {
        const loader = typeof loadConfigFn === 'function' ? loadConfigFn : loadConfig;
        const gen = typeof generateFn === 'function' ? generateFn : generateCaddyFromConfig;
        const cfg = loader() || {};
        gen(cfg, options);
        console.log('[caddy_from_config] Regenerated Caddyfile after config.json change.');
      } catch (err) {
        console.error('[caddy_from_config] Failed to regenerate Caddyfile on change:', err && err.message ? err.message : err);
      }
    });

    console.log('[caddy_from_config] Watching config.json for changes to regenerate Caddyfile.');
  } catch (err) {
    console.warn('[caddy_from_config] Unable to watch config file for changes:', err && err.message ? err.message : err);
  }
}

// -------------------------------
// CLI behavior (manual use)
// -------------------------------

if (require.main === module) {
  const cfg = loadConfig();
  const opts = getCaddyOptionsFromEnv();

  // If user is piping stdout, keep old behavior; if CADDYFILE_PATH/CADDY_FILE_OUT
  // is set, write to that path instead.
  const text = buildCaddyFromConfig(cfg, opts);

  if (process.env.CADDYFILE_PATH || process.env.CADDY_FILE_OUT) {
    writeCaddyfile(text, opts);
    if (opts.reloadCommand) {
      maybeReloadCaddy(opts);
    }
  } else {
    process.stdout.write(text);
  }
}

module.exports = {
  getCaddyOptionsFromEnv,
  buildCaddyFromConfig: buildCaddyFromConfig,
  generateCaddyFromConfig,
  watchConfigForCaddy
};
