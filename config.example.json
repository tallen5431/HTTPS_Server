{
  "hostname": "auto",
  "programs": [
    {
      "id": "codesmith-ollama",
      "name": "CodeSmith Ollama Assistant",
      "path": "/home/jupyter-tj/projects/CodeSmith_Ollama_Helper",
      "env": {
        "HOST": "0.0.0.0",
        "PORT": "8070",
        "PUBLIC_BASE": "https://192.168.1.245:8443",
        "URL_PREFIX": "/codesmith-ollama",
        "OLLAMA_HOST": "http://127.0.0.1:11434",
        "OLLAMA_MODEL": "qwen2.5-coder:7b"
      },
      "comment": "Ollama-based LLM helper tailored for CodeSmith (update path/IP as needed)"
    },
    {
      "id": "example-app-1",
      "name": "Example Application 1 (Auto URL)",
      "path": "/path/to/your/app1",
      "env": {
        "NODE_ENV": "production",
        "PORT": "8001"
      },
      "comment": "URL auto-generated using detected IP (works from any device)"
    },
    {
      "id": "example-app-2",
      "name": "Example Application 2 (Manual URL)",
      "path": "/path/to/your/app2",
      "url": "https://myapp.example.com",
      "env": {
        "PORT": "8002"
      },
      "comment": "Manual URL overrides auto-generation"
    },
    {
      "id": "example-app-3",
      "name": "Example Application 3 (No URL)",
      "path": "/path/to/your/app3",
      "env": {
        "NODE_ENV": "production"
      },
      "comment": "No PORT env var and no URL, so no clickable link will appear"
    }
  ],
  "ssl": {
    "cert": "./certs/server.crt",
    "key": "./certs/server.key",
    "autoGenerate": true
  }
}
